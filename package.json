{
  "name": "influencer-analytics-dashboard",
  "version": "1.0.0",
  "description": "Static influencer analytics dashboard built with HTML and Tailwind CSS v4 (no JavaScript).",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --minify",
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch",
    "start": "python3 server.py"
  },
